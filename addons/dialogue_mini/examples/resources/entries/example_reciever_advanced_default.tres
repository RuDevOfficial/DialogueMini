[ext_resource type="Script" uid="uid://cj1gc4gu106jp" path="res://addons/dialogue_mini/scripts/resources/dialogue/dialogue_entry/dialogue_step.gd" id="2_jxmp7"]

[sub_resource type="Resource" id="Resource_ai0qe"]
script = ExtResource("2_jxmp7")
text = "As you can see this dialogue is tied to a reciever via the \"Reference Name\" on the Entry."
metadata/_custom_type_script = "uid://cj1gc4gu106jp"

[sub_resource type="Resource" id="Resource_jxmp7"]
script = ExtResource("2_jxmp7")
text = "And in this case it's an advanced reciever, so there's a different animation on each key."
metadata/_custom_type_script = "uid://cj1gc4gu106jp"

[sub_resource type="Resource" id="Resource_okdbv"]
script = ExtResource("2_jxmp7")
text = "But this one has a defaut animation, so it will play if no specific indexes are set."
metadata/_custom_type_script = "uid://cj1gc4gu106jp"

[resource]
